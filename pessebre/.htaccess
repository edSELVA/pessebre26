# Aquesta carpeta (codi, configuració amb secrets i base de dades) no s'ha de poder llegir mai des del web.
# Millor posar-la fora de l'arrel web; si no es pot, aquest fitxer la bloqueja (Apache).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
